# Banco de dados Postgres. Use a connection string do banco de produção, ou de um
# Postgres local (ex.: via Docker) para desenvolvimento.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Conexão direta (sem pgbouncer), usada pelo Prisma Migrate para rodar alterações
# de schema. Com provedores como Neon, que usam connection pooling por padrão,
# isso evita falhas ao aplicar migrations. Se seu banco não usa pooling, pode
# repetir o mesmo valor de DATABASE_URL aqui.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/banco"

# Chave secreta usada pelo NextAuth para assinar sessões. Gere uma própria com:
# openssl rand -base64 32
AUTH_SECRET="troque-esta-chave-em-produção"

# URL pública do site. Opcional: com trustHost: true (src/auth.config.ts), o NextAuth
# detecta a URL a partir da requisição. Defina NEXTAUTH_URL apenas se quiser forçar
# um domínio canônico específico.
# NEXTAUTH_URL="https://seu-dominio.com.br"

# Definida automaticamente pela Vercel quando um Blob Store está conectado ao projeto
# (usada por src/lib/upload.ts para enviar arquivos em produção). Não precisa ser
# definida manualmente em desenvolvimento — sem ela, os uploads vão para public/uploads.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
